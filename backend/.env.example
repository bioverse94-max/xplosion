PORT=5000
NODE_ENV=production

# Supabase PostgreSQL Pooled Connection (Port 6543)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Connection for Migrations (Port 5432)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Frontend Vercel URL (Allowed CORS Origin)
FRONTEND_URL="https://your-frontend.vercel.app"

# Security Secrets (Generate random 32+ char hex strings)
HMAC_SECRET="your-hmac-secret-min-32-chars-change-in-production"
AUTH_SECRET="your-auth-session-secret-min-32-chars-change-in-production"

# Payment Gateway Configuration
PAYMENT_PROVIDER="MOCK" # Set to "RAZORPAY" for live merchant
AUTO_APPROVE_PAYMENTS="true"

# Automated Email Notifications (SMTP / Gmail App Password)
NOTIFICATION_PROVIDER="SMTP"
EMAIL_FROM="Neon Genesis 2026 Ticketing <tickets@neongenesis2026.com>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
