# -----------------------------------------------------------------------------
# SUPABASE POSTGRESQL DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Transaction pooled URL (Port 6543) with pgbouncer for high concurrency
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL (Port 5432) for running migrations (prisma db push)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# APPLICATION & DEPLOYMENT URLS
# -----------------------------------------------------------------------------
# Frontend URL on Vercel
NEXT_PUBLIC_APP_URL="https://your-frontend.vercel.app"

# Backend Render API URL
BACKEND_API_URL="https://your-backend.onrender.com"
NEXT_PUBLIC_API_URL="https://your-backend.onrender.com"

# -----------------------------------------------------------------------------
# CRYPTOGRAPHIC & SESSION SECRETS (Generate with: openssl rand -base64 32)
# -----------------------------------------------------------------------------
HMAC_SECRET="replace-with-a-min-32-char-random-secret"
AUTH_SECRET="replace-with-a-min-32-char-random-secret"

# -----------------------------------------------------------------------------
# PAYMENT GATEWAY SETTINGS
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER="MOCK" # "MOCK" or "RAZORPAY"
PAYMENT_KEY_ID="rzp_live_placeholder"
PAYMENT_KEY_SECRET="rzp_live_secret"
PAYMENT_WEBHOOK_SECRET="whsec_placeholder"
AUTO_APPROVE_PAYMENTS="true"

# UPI Settings
NEXT_PUBLIC_UPI_VPA="neongenesis2026@sbi"
NEXT_PUBLIC_UPI_NAME="Neon Genesis Fresher Party 2026"

# -----------------------------------------------------------------------------
# AUTOMATED EMAIL CONFIGURATION (SMTP / Gmail / Resend / SendGrid)
# -----------------------------------------------------------------------------
NOTIFICATION_PROVIDER="SMTP"
EMAIL_FROM="Neon Genesis 2026 Ticketing <tickets@neongenesis2026.com>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"
